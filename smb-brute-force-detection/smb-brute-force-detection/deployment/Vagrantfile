# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 2
  end

  # ==========================================
  # 1. OPNsense Firewall
  # ==========================================
  config.vm.define "opnsense" do |opnsense|
    opnsense.vm.box = "kruton/opnsense"
    opnsense.vm.hostname = "opnsense-fw"

    opnsense.vm.provider "virtualbox" do |vb|
      vb.name = "OPNsense-FW"
      vb.memory = "2048"
      vb.cpus = 3
    end

    # WAN segment - untrusted external network (REMnux lives here)
    opnsense.vm.network "private_network", ip: "192.168.57.254", 
      virtualbox__intnet: "wan_segment"

    # LAN segment - trusted internal network (DC, Splunk, Win10 live here)
    opnsense.vm.network "private_network", ip: "192.168.56.254",
      virtualbox__intnet: "lan_segment"

    opnsense.vm.synced_folder ".", "/vagrant", disabled: true
  end

  # ==========================================
  # 2. Domain Controller (Windows Server 2016)
  # ==========================================
  config.vm.define "dc" do |dc|
    dc.vm.box = "StefanScherer/windows_2016"
    dc.vm.hostname = "dc"

    dc.vm.provider "virtualbox" do |vb|
      vb.name = "dc.windomain.local"
      vb.memory = "3072"
      vb.cpus = 2
    end

    dc.vm.network "private_network", ip: "192.168.56.102",
      virtualbox__intnet: "lan_segment"

    dc.vm.provision "shell", path: "scripts/setup_dc.ps1"
  end

  # ==========================================
  # 3. Splunk SIEM (Ubuntu)
  # ==========================================
  config.vm.define "splunk" do |splunk|
    splunk.vm.box = "ubuntu/jammy64"
    splunk.vm.hostname = "splunk-siem"

    splunk.vm.provider "virtualbox" do |vb|
      vb.name = "Splunk-SIEM"
      vb.memory = "4096"
      vb.cpus = 3
    end

    splunk.vm.network "private_network", ip: "192.168.56.106",
      virtualbox__intnet: "lan_segment"

    splunk.vm.provision "shell", path: "scripts/setup_splunk.sh"
  end

  # ==========================================
  # 4. REMnux (Attacker)
  # ==========================================
  config.vm.define "remnux" do |remnux|
    remnux.vm.box = "remnux/remnux"
    remnux.vm.hostname = "remnux"

    remnux.vm.provider "virtualbox" do |vb|
      vb.name = "remnux-noble-amd64-virtualbox"
      vb.memory = "3096"
      vb.cpus = 2
    end

    remnux.vm.network "private_network", ip: "192.168.57.12",
      virtualbox__intnet: "wan_segment"

    remnux.vm.provision "shell", path: "scripts/setup_remnux.sh"
  end

  # ==========================================
  # 5. Windows 10 Workstation (Optional)
  # ==========================================
  config.vm.define "win10" do |win10|
    win10.vm.box = "StefanScherer/windows_10"
    win10.vm.hostname = "win10"

    win10.vm.provider "virtualbox" do |vb|
      vb.name = "win10.windomain.local"
      vb.memory = "2048"
      vb.cpus = 2
    end

    win10.vm.network "private_network", ip: "192.168.56.103",
      virtualbox__intnet: "lan_segment"
  end

end
